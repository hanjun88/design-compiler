{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartmirror.dev/schemas/validated-design-ir.schema.json",
  "title": "ValidatedDesignIR",
  "description": "通过 Meta Data Gate 校验的设计中间表示。P0 物理同构：与 compiler-core/contracts.ts 中 ValidatedDesignIR 接口 100% 映射。validatedIRHash 严禁存在于本实体内（Hash Flow Contract），仅存于下游 FidelityEvaluationResult.provenance.hashChain。",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "meta", "sourceRef", "patches", "validated", "auditReport"],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grammarPack", "grammarVersion", "compiledAt"],
      "properties": {
        "grammarPack": { "type": "string", "minLength": 1 },
        "grammarVersion": { "type": "string", "minLength": 1 },
        "compiledAt": { "type": "string", "format": "date-time" }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rawIRHash", "rawSchemaVersion"],
      "properties": {
        "rawIRHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "因果锁定：必须等于 RawDesignIR.provenance.rawIRHash"
        },
        "rawSchemaVersion": { "type": "string", "minLength": 1 }
      }
    },
    "rawSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rawIRHash", "snapshotPayload"],
      "properties": {
        "rawIRHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "snapshotPayload": { "type": "object" }
      }
    },
    "patches": {
      "type": "array",
      "items": { "$ref": "#/$defs/RFC6902Op" },
      "description": "RFC 6902 补丁序列。PATCH DETERMINISM CONTRACT：必须按 audit.ruleId 字典序（ASCII 升序）排列。"
    },
    "validated": { "$ref": "#/$defs/ValidatedSceneGraph" },
    "auditReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rulesEvaluated", "patchesEvaluated", "mutationsApplied", "testsPassed", "testsFailed", "complianceScore", "violations"],
      "properties": {
        "rulesEvaluated": { "type": "integer", "minimum": 0 },
        "patchesEvaluated": { "type": "integer", "minimum": 0 },
        "mutationsApplied": { "type": "integer", "minimum": 0 },
        "testsPassed": { "type": "integer", "minimum": 0 },
        "testsFailed": { "type": "integer", "minimum": 0 },
        "complianceScore": { "type": "number", "minimum": 0, "maximum": 1 },
        "violations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ruleId", "severity", "actionTaken", "message"],
            "properties": {
              "ruleId": { "type": "string", "minLength": 1 },
              "severity": { "type": "string", "enum": ["P0_CRITICAL", "P1_WARNING", "P2_INFO"] },
              "actionTaken": { "type": "string", "enum": ["MUTATED", "TESTED", "REJECTED_ERROR"] },
              "message": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "ValidatedEstimatedParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "confidence", "status", "evidence", "source"],
      "properties": {
        "value": {},
        "unit": {
          "type": "string",
          "enum": ["normalized", "kelvin", "degrees", "ratio", "ms", "scalar", "hex", "vector2", "vector3"]
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "status": {
          "type": "string",
          "enum": ["observed", "estimated", "derived", "unknown", "grammar-derived"]
        },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "source": {
          "type": "string",
          "enum": ["vision-estimation", "depth-estimator", "optical-flow", "fallback-default", "grammar-rule"]
        },
        "derivedFrom": { "type": "string" }
      }
    },
    "ValidatedComposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["focalPoint", "negativeSpaceRatio", "depthLayerCount", "symmetry"],
      "properties": {
        "focalPoint": { "$ref": "#/$defs/ValidatedEstimatedParameter" },
        "negativeSpaceRatio": { "$ref": "#/$defs/ValidatedEstimatedParameter" },
        "depthLayerCount": { "$ref": "#/$defs/ValidatedEstimatedParameter" },
        "symmetry": { "$ref": "#/$defs/ValidatedEstimatedParameter" }
      }
    },
    "ValidatedCamera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fov", "shotSize", "angle", "height"],
      "properties": {
        "fov": { "$ref": "#/$defs/ValidatedEstimatedParameter" },
        "shotSize": { "$ref": "#/$defs/ValidatedEstimatedParameter" },
        "angle": { "$ref": "#/$defs/ValidatedEstimatedParameter" },
        "height": { "$ref": "#/$defs/ValidatedEstimatedParameter" }
      }
    },
    "ValidatedLighting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyLight", "ambientRatio", "rimLightPresent"],
      "properties": {
        "keyLight": {
          "type": "object",
          "additionalProperties": false,
          "required": ["azimuth", "elevation", "colorTemp", "intensity", "softness"],
          "properties": {
            "azimuth": { "$ref": "#/$defs/ValidatedEstimatedParameter" },
            "elevation": { "$ref": "#/$defs/ValidatedEstimatedParameter" },
            "colorTemp": { "$ref": "#/$defs/ValidatedEstimatedParameter" },
            "intensity": { "$ref": "#/$defs/ValidatedEstimatedParameter" },
            "softness": { "$ref": "#/$defs/ValidatedEstimatedParameter" }
          }
        },
        "ambientRatio": { "$ref": "#/$defs/ValidatedEstimatedParameter" },
        "rimLightPresent": { "$ref": "#/$defs/ValidatedEstimatedParameter" }
      }
    },
    "ValidatedMaterialItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "baseType", "roughness", "metalness", "wear"],
      "properties": {
        "role": { "type": "string", "enum": ["dominant", "secondary", "accent", "ground"] },
        "baseType": { "$ref": "#/$defs/ValidatedEstimatedParameter" },
        "roughness": { "$ref": "#/$defs/ValidatedEstimatedParameter" },
        "metalness": { "$ref": "#/$defs/ValidatedEstimatedParameter" },
        "wear": { "$ref": "#/$defs/ValidatedEstimatedParameter" }
      }
    },
    "ValidatedColor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dominant", "secondary", "accent", "contrastRatio", "temperatureBias"],
      "properties": {
        "dominant": { "$ref": "#/$defs/ValidatedEstimatedParameter" },
        "secondary": { "$ref": "#/$defs/ValidatedEstimatedParameter" },
        "accent": { "$ref": "#/$defs/ValidatedEstimatedParameter" },
        "contrastRatio": { "$ref": "#/$defs/ValidatedEstimatedParameter" },
        "temperatureBias": { "$ref": "#/$defs/ValidatedEstimatedParameter" }
      }
    },
    "ValidatedSceneGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["composition", "camera", "lighting", "materials", "color"],
      "properties": {
        "composition": { "$ref": "#/$defs/ValidatedComposition" },
        "camera": { "$ref": "#/$defs/ValidatedCamera" },
        "lighting": { "$ref": "#/$defs/ValidatedLighting" },
        "materials": {
          "type": "array",
          "items": { "$ref": "#/$defs/ValidatedMaterialItem" }
        },
        "color": { "$ref": "#/$defs/ValidatedColor" }
      }
    },
    "AuditMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "principle", "reason"],
      "properties": {
        "ruleId": { "type": "string", "minLength": 1 },
        "principle": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "fromValue": {}
      }
    },
    "RFC6902Op": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "path", "value", "audit"],
          "properties": {
            "op": { "type": "string", "const": "add" },
            "path": { "type": "string" },
            "value": {},
            "audit": { "$ref": "#/$defs/AuditMetadata" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "path", "audit"],
          "properties": {
            "op": { "type": "string", "const": "remove" },
            "path": { "type": "string" },
            "audit": { "$ref": "#/$defs/AuditMetadata" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "path", "value", "audit"],
          "properties": {
            "op": { "type": "string", "const": "replace" },
            "path": { "type": "string" },
            "value": {},
            "audit": { "$ref": "#/$defs/AuditMetadata" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "from", "path", "audit"],
          "properties": {
            "op": { "type": "string", "const": "move" },
            "from": { "type": "string" },
            "path": { "type": "string" },
            "audit": { "$ref": "#/$defs/AuditMetadata" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "from", "path", "audit"],
          "properties": {
            "op": { "type": "string", "const": "copy" },
            "from": { "type": "string" },
            "path": { "type": "string" },
            "audit": { "$ref": "#/$defs/AuditMetadata" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["op", "path", "value", "audit"],
          "properties": {
            "op": { "type": "string", "const": "test" },
            "path": { "type": "string" },
            "value": {},
            "audit": { "$ref": "#/$defs/AuditMetadata" }
          }
        }
      ]
    }
  }
}
