{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0.0",
  "requiredCapabilities": ["webgl2", "floatTextures"],
  "preferredCapabilities": ["anisotropyExtension", "highPrecisionFragment"],
  "tiers": {
    "TIER_A": {
      "rendererType": "WebGL2Renderer",
      "requiredPreferredCapabilities": ["anisotropyExtension", "highPrecisionFragment"],
      "toneMapping": "AgXToneMapping",
      "colorSpace": "srgb",
      "postprocessing": ["bloom", "volumetric-fog"],
      "rendererConfig": {
        "antialias": "SMAA_2X",
        "shadowMap": "PCF_SOFT",
        "toneMapping": "AgX",
        "exposure": 1.05
      },
      "postProcessingConfig": {
        "filmGrain": {
          "enabled": true,
          "distribution": "POISSON",
          "intensity": 0.045,
          "temporalJitter": true
        },
        "chromaticAberration": {
          "enabled": true,
          "radialOffset": 0.0018
        },
        "lensVignette": {
          "enabled": true,
          "falloff": 0.28,
          "darkness": 0.35
        },
        "physicalBokeh": {
          "enabled": true,
          "apertureBlades": 9,
          "fStop": 2.8
        }
      },
      "cameraRigConfig": {
        "damping": {
          "linear": 0.085,
          "rotational": 0.065
        },
        "easing": "CUBIC_BEZIER_MECHANICAL"
      }
    },
    "TIER_B": {
      "rendererType": "WebGL1Renderer",
      "requiredPreferredCapabilities": ["highPrecisionFragment"],
      "toneMapping": "ACESFilmicToneMapping",
      "colorSpace": "srgb",
      "postprocessing": ["bloom"]
    },
    "TIER_C": {
      "rendererType": "CSS3D",
      "requiredPreferredCapabilities": [],
      "toneMapping": "LinearToneMapping",
      "colorSpace": "srgb",
      "postprocessing": []
    },
    "TIER_D": {
      "rendererType": "HeadlessNull",
      "requiredPreferredCapabilities": [],
      "toneMapping": "LinearToneMapping",
      "colorSpace": "srgb",
      "postprocessing": []
    },
    "NONE": {
      "rendererType": "HeadlessNull",
      "requiredPreferredCapabilities": [],
      "toneMapping": "LinearToneMapping",
      "colorSpace": "srgb",
      "postprocessing": []
    }
  }
}
