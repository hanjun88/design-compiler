{
  "name": "design-compiler",
  "version": "1.0.0-rc",
  "description": "Deterministic Design Compiler ABI & Core Verification Suite",
  "main": "index.ts",
  "scripts": {
    "test": "ts-node --project tsconfig.test.json tests/runner.test.ts",
    "test:contract": "jest tests/contract/ --runInBand",
    "test:all": "npm run test && npm run test:contract",
    "build": "tsc",
    "bundle:pipeline": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"moduleResolution\":\"node\"}' ts-node scripts/heartmirror-bundle-pipeline.ts",
    "validate:schemas": "node scripts/validate-schemas.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "design-compiler",
    "aesthetic",
    "chinese-aesthetic",
    "deterministic",
    "provenance",
    "webgl",
    "heartmirror"
  ],
  "license": "MIT",
  "dependencies": {
    "canonicalize": "^2.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.0",
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "chinese-aesthetic-skill": "github:hanjun88/chinese-aesthetic-skill#6ce123d",
    "jest": "^29.7.0",
    "js-yaml": "^3.15.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
