{
  "name": "design-compiler",
  "version": "1.0.0-rc",
  "description": "Deterministic Design Compiler ABI & Core Verification Suite",
  "main": "index.ts",
  "scripts": {
    "typecheck": "node scripts/verify-typescript.mjs",
    "build": "tsc -p tsconfig.json",
    "validate:schemas": "node scripts/validate-schemas.mjs",
    "test:abi": "ts-node --project tsconfig.test.json tests/runner.test.ts",
    "test:unit": "jest",
    "test:unit:serial": "jest --runInBand",
    "test:contract": "jest tests/contract/",
    "test:intent": "jest tests/intent/",
    "test:aesthetic": "jest tests/chinese-aesthetic/",
    "test:golden": "jest tests/golden-case-matrix/",
    "verify:test-coverage": "node scripts/verify-test-coverage.mjs",
    "test": "npm run test:abi && npm run test:unit",
    "test:all": "npm run typecheck && npm run build && npm run validate:schemas && npm run verify:test-coverage && npm run test",
    "golden:reseal": "ts-node --project tsconfig.test.json scripts/golden/reseal.ts",
    "lint:ssot": "node scripts/lint-aesthetic-ssot.mjs",
    "contract:check": "node scripts/contract/lock-contract.mjs --check",
    "binding:pin": "ts-node --project tsconfig.test.json scripts/binding/pin-binding.ts",
    "binding:verify": "ts-node --project tsconfig.test.json scripts/binding/verify-binding.ts"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "keywords": [
    "design-compiler",
    "aesthetic",
    "chinese-aesthetic",
    "deterministic",
    "provenance",
    "webgl",
    "heartmirror"
  ],
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^2.1.1",
    "canonicalize": "^2.0.0",
    "semver": "^7.8.5",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.0",
    "@types/pngjs": "^6.0.5",
    "@types/semver": "^7.8.0",
    "jest": "^29.7.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
